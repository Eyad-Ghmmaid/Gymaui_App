<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Gymaui_App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Gymaui_App"
    xmlns:views="clr-namespace:Gymaui_App.Views"
    xmlns:controls="clr-namespace:Gymaui_App.Controls"
    Title="Gymaui_App"
    BackgroundColor="{DynamicResource BackgroundDark}"
    Shell.TabBarBackgroundColor="{DynamicResource Surface}"
    Shell.TabBarTitleColor="{DynamicResource PrimaryAccent}"
    Shell.TabBarUnselectedColor="{DynamicResource TextSecondary}"
    Shell.TabBarForegroundColor="{DynamicResource PrimaryAccent}">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="#FFFFFF" />
            </Style>
            <Style TargetType="Frame">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="HasShadow" Value="True" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Tab 1: Home → StartPage -->
    <TabBar>
        <ShellContent
            x:Name="HomeTab"
            Title="Start"
            Icon="home.png"
            ContentTemplate="{DataTemplate views:StartPage}"
            Route="home" />

        <!-- Tab 2: Workout → ActiveWorkoutPage -->
        <ShellContent
            x:Name="WorkoutTab"
            Title="Training"
            Icon="training.png"
            ContentTemplate="{DataTemplate views:ActiveWorkoutPage}"
            Route="workout" />


        <!-- Tab 3: Pläne → PlansPage -->
        <ShellContent
            x:Name="PlansTab"
            Title="Pläne"
            Icon="plaene.png"
            ContentTemplate="{DataTemplate views:PlansPage}"
            Route="plans" />

        <!-- Tab 4: Trainingstage → WorkoutHistoryPage -->
        <ShellContent
            x:Name="HistoryTab"
            Title="Tage"
            Icon="seven_days.png"
            ContentTemplate="{DataTemplate views:WorkoutHistoryPage}"
            Route="history" />

        <!-- Tab 5: Calendar → CalendarPage -->
        <ShellContent
            x:Name="CalendarTab"
            Title="Kalender"
            Icon="calendar.png"
            ContentTemplate="{DataTemplate views:CalendarPage}"
            Route="calendar" />

        <!-- Tab 5: Stats → StatisticsPage -->
        <ShellContent
            x:Name="StatsTab"
            Title="Statistik"
            Icon="statistics.png"
            ContentTemplate="{DataTemplate views:StatisticsPage}"
            Route="stats" />

    <!-- Tab 6: Exercises → ExerciseListPage -->
        <ShellContent
            x:Name="ExercisesTab"
            Title="Übungen"
            Icon="strength.png"
            ContentTemplate="{DataTemplate views:ExerciseListPage}"
            Route="exercises" />

    <!-- Tab 8: Help → HelpPage -->
        <ShellContent
            x:Name="HelpTab"
            Title="Hilfe"
            Icon="help.png"
            ContentTemplate="{DataTemplate views:HelpPage}"
            Route="help" />
    </TabBar>

</Shell>
