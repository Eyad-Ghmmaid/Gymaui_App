<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Gymaui_App.Views"
             x:Class="Gymaui_App.AppShellContainer"
             Title="Gymaui App"
             BackgroundColor="#0D0D0D"
             Padding="0">

	<Grid RowDefinitions="*,80" ColumnDefinitions="*">

		<!-- Content Area -->
		<ContentView x:Name="ContentArea" Grid.Row="0" BackgroundColor="#0D0D0D">
			<!-- Placeholder while loading -->
			<VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16" Padding="20">
				<Label Text="Loading..." 
				       TextColor="#FFFFFF" 
				       FontSize="24"
				       HorizontalOptions="Center"/>
			</VerticalStackLayout>
		</ContentView>

		<!-- Bottom Tab Bar mit Border -->
		<Border Grid.Row="1"
                BackgroundColor="#1A1A1A"
                Stroke="#2A2A2A"
                StrokeThickness="1,0,0,0">

			<Grid ColumnDefinitions="*,*,*,*,*"
                  Padding="0"
                  Margin="0">

				<!-- Tab 1: Home -->
				<Button Grid.Column="0"
                        x:Name="HomeTabBtn"
                        Text="🏠 Home"
                        Clicked="OnHomeTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="#E8FF47"
                        FontSize="14"
                        Padding="8"
                        CornerRadius="0"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"/>

				<!-- Tab 2: Workout -->
				<Button Grid.Column="1"
                        x:Name="WorkoutTabBtn"
                        Text="💪 Workout"
                        Clicked="OnWorkoutTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="#8A8A8A"
                        FontSize="14"
                        Padding="8"
                        CornerRadius="0"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"/>

				<!-- Tab 3: Plans -->
				<Button Grid.Column="2"
                        x:Name="PlansTabBtn"
                        Text="📋 Plans"
                        Clicked="OnPlansTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="#8A8A8A"
                        FontSize="14"
                        Padding="8"
                        CornerRadius="0"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"/>

				<!-- Tab 4: Stats -->
				<Button Grid.Column="3"
                        x:Name="StatsTabBtn"
                        Text="📊 Stats"
                        Clicked="OnStatsTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="#8A8A8A"
                        FontSize="14"
                        Padding="8"
                        CornerRadius="0"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"/>

				<!-- Tab 5: Exercises -->
				<Button Grid.Column="4"
                        x:Name="ExercisesTabBtn"
                        Text="🏋️ Exercises"
                        Clicked="OnExercisesTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="#8A8A8A"
                        FontSize="14"
                        Padding="8"
                        CornerRadius="0"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"/>

			</Grid>
		</Border>
	</Grid>

</ContentPage>