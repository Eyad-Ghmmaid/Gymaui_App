<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gymaui_App.Controls.CustomHeader"
             Padding="0">

    <VerticalStackLayout Spacing="0">
        <!-- Main Header Bar -->
        <Border Stroke="#2A2A2A" StrokeThickness="1">
            <Grid RowDefinitions="56" ColumnDefinitions="auto,*,auto" 
                  BackgroundColor="#1A1A1A" Padding="12,8,12,8">
                
                <!-- Back Button (Column 0) -->
				<ImageButton x:Name="BackButton" 
						Grid.Column="0"
						Source="back_icon.png"
						BackgroundColor="Transparent"
						Padding="4"
						Clicked="OnBackClicked"
						CornerRadius="0"
						IsVisible="False"
						WidthRequest="36"
						HeightRequest="36"
						Aspect="AspectFit" />

                <!-- Title with Icon (Column 1) -->
                <HorizontalStackLayout Grid.Column="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Start"
                                       Spacing="8"
                                       Margin="8,0,0,0">
                    <Image x:Name="IconLabel"
                           Source="calendar.png"
                           WidthRequest="30"
                           HeightRequest="30"
                           VerticalOptions="Center" />
                    
                    <Label x:Name="TitleLabel"
                           Text="Training Calendar"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Right Action Buttons (Column 2) -->
                <HorizontalStackLayout Grid.Column="2" 
                                       x:Name="RightContentPlaceholder"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       Spacing="8">
                    <!-- Settings/Menu Button -->
                    <ImageButton x:Name="SettingsButton"
                            Source="cogwheel.png"
                            BackgroundColor="Transparent"
                            Padding="4"
                            Clicked="OnSettingsClicked"
                            CornerRadius="0"
                            WidthRequest="36"
                            HeightRequest="36"
                            Aspect="AspectFit"
                            IsVisible="True" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Search Bar (Collapsible) -->
        <Border x:Name="SearchBarContainer"
                Stroke="#2A2A2A"
                StrokeThickness="1"
                BackgroundColor="#0D0D0D"
                IsVisible="False"
                Padding="0">
            <HorizontalStackLayout Padding="12,8,12,8" Spacing="8">
                <SearchBar x:Name="SearchEntry"
                           Placeholder="Suchen..."
                           PlaceholderColor="#8A8A8A"
                           TextColor="#FFFFFF"
                           BackgroundColor="#1A1A1A"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="Center"
                           TextChanged="OnSearchTextChanged"
                           SearchButtonPressed="OnSearchPressed"/>
                
                <Button x:Name="CloseSearchButton"
                        Text="✕"
                        FontSize="16"
                        TextColor="#8A8A8A"
                        BackgroundColor="Transparent"
                        Padding="0"
                        Clicked="OnCloseSearchClicked"
                        CornerRadius="0"
                        WidthRequest="40"
                        HeightRequest="40"/>
            </HorizontalStackLayout>
        </Border>
    </VerticalStackLayout>

</ContentView>
