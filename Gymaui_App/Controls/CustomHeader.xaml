<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
         x:Class="Gymaui_App.Controls.CustomHeader"
         Padding="0"
         HeightRequest="64">

<Border Stroke="#2A2A2A" StrokeThickness="0,1,0,0">
    <Grid RowDefinitions="64" ColumnDefinitions="auto,*,auto" 
          BackgroundColor="#1A1A1A" Padding="16,12,16,12">
        
        <!-- Back Button -->
        <Button x:Name="BackButton" 
                Grid.Column="0"
                Text="←" 
                FontSize="20"
                TextColor="#8A8A8A"
                BackgroundColor="Transparent"
                Padding="0"
                Clicked="OnBackClicked"
                CornerRadius="0"
                IsVisible="False"
                WidthRequest="44"
                HeightRequest="44"/>

        <!-- Title -->
        <Label x:Name="TitleLabel"
               Grid.Column="1"
               Text="Home"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="#FFFFFF"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               Margin="16,0,16,0"/>

        <!-- Placeholder for right content -->
        <StackLayout Grid.Column="2" x:Name="RightContentPlaceholder" />
    </Grid>
    </Border>

</ContentView>


