<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Border Radius -->
    <x:Int32 x:Key="CornerRadiusSmall">8</x:Int32>
    <x:Int32 x:Key="CornerRadiusMedium">12</x:Int32>
    <x:Int32 x:Key="CornerRadiusLarge">16</x:Int32>
    <x:Int32 x:Key="CornerRadiusPill">24</x:Int32>
    
    <!-- Spacing -->
    <x:Double x:Key="SpaceXXS">4</x:Double>
    <x:Double x:Key="SpaceXS">8</x:Double>
    <x:Double x:Key="SpaceSM">12</x:Double>
    <x:Double x:Key="SpaceBase">16</x:Double>
    <x:Double x:Key="SpaceMD">20</x:Double>
    <x:Double x:Key="SpaceLG">24</x:Double>
    <x:Double x:Key="SpaceXL">32</x:Double>
    <x:Double x:Key="SpaceXXL">48</x:Double>
    
    <!-- Typography Sizes -->
    <x:Double x:Key="FontSizeHeadline">32</x:Double>
    <x:Double x:Key="FontSizeSubHeading">18</x:Double>
    <x:Double x:Key="FontSizeTitle">16</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeLabel">12</x:Double>
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    
    <!-- Component Sizes -->
    <x:Double x:Key="ButtonMinHeight">48</x:Double>
    <x:Double x:Key="ButtonMinWidth">120</x:Double>
    <x:Double x:Key="InputMinHeight">48</x:Double>
    <x:Double x:Key="CardShadowOffset">2</x:Double>
    
</ResourceDictionary>
