<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- BUTTON STYLES -->
    <Style TargetType="Button" x:Key="ButtonPrimary">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryAccent}" />
        <Setter Property="TextColor" Value="{DynamicResource BackgroundDark}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
        <Setter Property="Padding" Value="{DynamicResource SpaceBase}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ButtonMinHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource ButtonMinWidth}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Button" x:Key="ButtonSecondary">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryAccent}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
        <Setter Property="Padding" Value="{DynamicResource SpaceBase}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ButtonMinHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource ButtonMinWidth}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Button" x:Key="ButtonDanger">
        <Setter Property="BackgroundColor" Value="{DynamicResource Danger}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
        <Setter Property="Padding" Value="{DynamicResource SpaceBase}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ButtonMinHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource ButtonMinWidth}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Button" x:Key="ButtonSuccess">
        <Setter Property="BackgroundColor" Value="{DynamicResource Success}" />
        <Setter Property="TextColor" Value="{DynamicResource BackgroundDark}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusPill}" />
        <Setter Property="Padding" Value="{DynamicResource SpaceBase}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ButtonMinHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{DynamicResource ButtonMinWidth}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- LABEL STYLES -->
    <Style TargetType="Label" x:Key="LabelHeadline">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeadline}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" x:Key="LabelSubHeading">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubHeading}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" x:Key="LabelTitle">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" x:Key="LabelBody">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style TargetType="Label" x:Key="LabelSecondary">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style TargetType="Label" x:Key="LabelCaption">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- ENTRY STYLES -->
    <Style TargetType="Entry" x:Key="EntryInput">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface2}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource InputMinHeight}" />
    </Style>

    <!-- FRAME STYLES (Cards) -->
    <Style TargetType="Frame" x:Key="CardDefault">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="BorderColor" Value="{DynamicResource Surface2}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="Padding" Value="{DynamicResource SpaceBase}" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style TargetType="Frame" x:Key="CardHighlight">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="BorderColor" Value="{DynamicResource PrimaryAccent}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="Padding" Value="{DynamicResource SpaceBase}" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- STACKLAYOUT STYLES -->
    <Style TargetType="StackLayout" x:Key="StackDefault">
        <Setter Property="Spacing" Value="{DynamicResource SpaceBase}" />
    </Style>

    <!-- LIST ITEM STYLING -->
    <DataTemplate x:Key="ListItemTemplate">
        <Frame Style="{DynamicResource CardDefault}"
               Padding="20,16,20,16">
            <Label Style="{DynamicResource LabelBody}" 
                   Text="{Binding .}" />
        </Frame>
    </DataTemplate>

</ResourceDictionary>
