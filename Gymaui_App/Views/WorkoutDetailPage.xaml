<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Gymaui_App.Controls"
             xmlns:converters="clr-namespace:Gymaui_App.Converters"
             x:Class="Gymaui_App.Views.WorkoutDetailPage"
             Title="Trainingsdetails"
             BackgroundColor="#0D0D0D"
             Padding="0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">

        <controls:CustomHeader
            x:Name="CustomHeader"
            Grid.Row="0"
            Title="📋 Trainingsdetails"
            ShowBackButton="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12" Spacing="12" BackgroundColor="#0D0D0D">

                <Label x:Name="SessionDateLabel"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#E8FF47" />

                <CollectionView x:Name="ExercisesCollection"
                                SelectionMode="Single"
                                SelectionChanged="OnExerciseSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="#2A2A2A"
                                    StrokeThickness="1"
                                    Padding="14"
                                    Margin="0,4"
                                    BackgroundColor="#1A1A1A">
                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding ExerciseName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#FFFFFF"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1"
                                               Text="{Binding MuscleGroup}"
                                               FontSize="12"
                                               TextColor="#8A8A8A"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <Label Text="{Binding TargetInfo}"
                                           FontSize="12"
                                           TextColor="#8A8A8A" />

                                    <CollectionView ItemsSource="{Binding Logs}"
                                                    SelectionMode="None"
                                                    HeightRequest="{Binding LogsHeight}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <SwipeView>
                                                    <SwipeView.LeftItems>
                                                        <SwipeItems>
                                                            <SwipeItem Text="✏ Bearbeiten" BackgroundColor="#E8FF47" Invoked="OnEditLogSwipe" CommandParameter="{Binding .}" />
                                                        </SwipeItems>
                                                    </SwipeView.LeftItems>
                                                    <SwipeView.RightItems>
                                                        <SwipeItems>
                                                            <SwipeItem Text="🗑 Löschen" BackgroundColor="#FF4444" Invoked="OnDeleteLogSwipe" CommandParameter="{Binding .}" />
                                                        </SwipeItems>
                                                    </SwipeView.RightItems>
                                                    <VerticalStackLayout Padding="4,2" Spacing="2">
                                                        <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="12">
                                                            <Label Grid.Column="0"
                                                                   Text="{Binding SetNumber, StringFormat='Satz {0}'}"
                                                                   FontSize="13"
                                                                   TextColor="#8A8A8A" />
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding Weight, StringFormat='{0} kg'}"
                                                                   FontSize="13"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#E8FF47" />
                                                            <Label Grid.Column="2"
                                                                   Text="{Binding Reps, StringFormat='{0} Wdh'}"
                                                                   FontSize="13"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#E8FF47" />
                                                        </Grid>
                                                        <Label Text="{Binding Notes, StringFormat='📝 {0}'}"
                                                               FontSize="11"
                                                               TextColor="#8A8A8A"
                                                               IsVisible="{Binding Notes, Converter={StaticResource StringNotEmptyConverter}}"
                                                               Margin="0,0,0,4"
                                                               LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                </SwipeView>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <Label Text="Tippe um Saetze einzutragen"
                                           FontSize="12"
                                           TextColor="#555555"
                                           IsVisible="{Binding HasNoLogs}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
