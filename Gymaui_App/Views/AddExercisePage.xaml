<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Gymaui_App.Controls"
             x:Class="Gymaui_App.Views.AddExercisePage"
             Title="Übung hinzufügen"
             BackgroundColor="#0D0D0D"
             Padding="0">

	<Grid RowDefinitions="auto,*" ColumnDefinitions="*">

		<!-- Custom Header with Back Button -->
		<controls:CustomHeader
            x:Name="CustomHeader"
            Grid.Row="0"
            Title="Uebung Hinzufuegen"
            ShowBackButton="True" />

		<!-- Content -->
		<ScrollView Grid.Row="1">
			<VerticalStackLayout Padding="16" Spacing="12" BackgroundColor="#0D0D0D">

				<!-- Uebungsname -->
				<Label Text="Uebungsname" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" />
				<Entry x:Name="NameEntry"
                       Placeholder="z.B. Bankdruecken"
                       BackgroundColor="#1A1A1A"
                       TextColor="#FFFFFF"
                       PlaceholderColor="#8A8A8A" />
				<Label x:Name="NameErrorLabel" TextColor="#FF6B6B" FontSize="11" IsVisible="False" />

				<!-- Muskelgruppe -->
				<Label Text="Muskelgruppe" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" Margin="0,12,0,0" />
				
			<CollectionView x:Name="MuscleGroupCollection"
                                Margin="0,8,0,0"
                                SelectionMode="None">
					<CollectionView.ItemsLayout>
						<GridItemsLayout Orientation="Vertical"
                                         Span="3"
                                         HorizontalItemSpacing="12"
                                         VerticalItemSpacing="12" />
					</CollectionView.ItemsLayout>
					<CollectionView.ItemTemplate>
						<DataTemplate>
							<Frame Padding="12"
                                       CornerRadius="12"
                                       BackgroundColor="#1A1A1A"
                                       BorderColor="#2A2A2A"
                                       HasShadow="False">
								<Frame.GestureRecognizers>
									<TapGestureRecognizer Tapped="OnMuscleGroupSelected" />
								</Frame.GestureRecognizers>
								<StackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
									<Image Source="{Binding ., Converter={StaticResource MuscleGroupIconConverter}}"
                                               HeightRequest="36"
                                               WidthRequest="36"
                                               HorizontalOptions="Center" />
									<Label Text="{Binding .}"
                                               TextColor="#FFFFFF"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" />
								</StackLayout>
							</Frame>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>
				<Label x:Name="MuscleGroupErrorLabel" TextColor="#FF6B6B" FontSize="11" IsVisible="False" />

				<!-- Ziel-Saetze -->
				<Label Text="Ziel-Saetze" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" Margin="0,12,0,0" />
				<Entry x:Name="SetsEntry"
                       Text="3"
                       Keyboard="Numeric"
                       Placeholder="z.B. 3"
                       BackgroundColor="#1A1A1A"
                       TextColor="#FFFFFF"
                       PlaceholderColor="#8A8A8A" />
				<Label x:Name="SetsErrorLabel" TextColor="#FF6B6B" FontSize="11" IsVisible="False" />

				<!-- Ziel-Wiederholungen -->
				<Label Text="Ziel-Wiederholungen" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" Margin="0,12,0,0" />
				<Entry x:Name="RepsEntry"
                       Text="10"
                       Keyboard="Numeric"
                       Placeholder="z.B. 10"
                       BackgroundColor="#1A1A1A"
                       TextColor="#FFFFFF"
                       PlaceholderColor="#8A8A8A" />
				<Label x:Name="RepsErrorLabel" TextColor="#FF6B6B" FontSize="11" IsVisible="False" />

				<!-- YouTube URL -->
				<Label Text="YouTube URL (optional)" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" Margin="0,12,0,0" />
				<Entry x:Name="YouTubeEntry"
                       Keyboard="Url"
                       Placeholder="https://youtu.be/..."
                       BackgroundColor="#1A1A1A"
                       TextColor="#FFFFFF"
                       PlaceholderColor="#8A8A8A" />
				<Label x:Name="YoutubeErrorLabel" TextColor="#FF6B6B" FontSize="11" IsVisible="False" />

			<!-- Buttons -->
				<HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,20,0,0">
					<Button Text="Speichern"
                            x:Name="SaveButton"
                            Clicked="OnSaveClicked"
                            BackgroundColor="#E8FF47"
                            TextColor="#000000"
                            FontAttributes="Bold"
                            WidthRequest="140"
                            CornerRadius="8" />
					<Button Text="Abbrechen"
                            Clicked="OnCancelClicked"
                            BackgroundColor="#8A8A8A"
                            TextColor="#000000"
                            FontAttributes="Bold"
                            WidthRequest="140"
                            CornerRadius="8" />
				</HorizontalStackLayout>

				<!-- Delete Button (only visible in edit mode) -->
				<Button x:Name="DeleteButton"
                        Text="Übung Loeschen"
                        Clicked="OnDeleteClicked"
                        BackgroundColor="#FF4444"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        IsVisible="False"
                        HorizontalOptions="Center"
                        WidthRequest="200"
                        Margin="0,12,0,0" />
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</ContentPage>
