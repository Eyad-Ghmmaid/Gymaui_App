<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gymaui_App.Views.SettingsPage"
             Title="Einstellungen"
             BackgroundColor="{StaticResource BackgroundDark}"
             Shell.NavBarIsVisible="False"
             Padding="0">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Surface}"
                Stroke="#2A2A2A"
                StrokeThickness="1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Text="Zurück"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource PrimaryAccent}"
                        FontSize="16"
                        Padding="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="⚙️ Einstellungen"
                       TextColor="{StaticResource TextPrimary}"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="20">

                <!-- Section: Theme / Erscheinungsbild -->
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="#2A2A2A"
                        StrokeThickness="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🎨 Erscheinungsbild"
                               TextColor="{StaticResource PrimaryAccent}"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label Text="Waehle zwischen Dunkel- und Hellmodus."
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label x:Name="ThemeModeLabel"
                                   Text="Dunkelmodus"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            <Switch x:Name="ThemeSwitch"
                                    Grid.Column="1"
                                    Toggled="OnThemeToggled"
                                    OnColor="{StaticResource PrimaryAccent}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Default Rest Timer -->
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="#2A2A2A"
                        StrokeThickness="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="⏱️ Standard-Pausenzeit"
                               TextColor="{StaticResource PrimaryAccent}"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label Text="Waehle die Standard-Pausenzeit zwischen Saetzen."
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13" />

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Button x:Name="Timer30Btn" Grid.Column="0" Text="30s" Clicked="OnRestTimerChanged" CommandParameter="30"
                                    BackgroundColor="#2A2A2A" TextColor="{StaticResource TextPrimary}" CornerRadius="8" />
                            <Button x:Name="Timer60Btn" Grid.Column="1" Text="60s" Clicked="OnRestTimerChanged" CommandParameter="60"
                                    BackgroundColor="{StaticResource PrimaryAccent}" TextColor="#000000" CornerRadius="8" FontAttributes="Bold" />
                            <Button x:Name="Timer90Btn" Grid.Column="2" Text="90s" Clicked="OnRestTimerChanged" CommandParameter="90"
                                    BackgroundColor="#2A2A2A" TextColor="{StaticResource TextPrimary}" CornerRadius="8" />
                            <Button x:Name="Timer120Btn" Grid.Column="3" Text="120s" Clicked="OnRestTimerChanged" CommandParameter="120"
                                    BackgroundColor="#2A2A2A" TextColor="{StaticResource TextPrimary}" CornerRadius="8" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Danger Zone -->
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="#2A2A2A"
                        StrokeThickness="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="⚠️ Gefahrenzone"
                               TextColor="#FF4444"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label Text="Alle Daten zuruecksetzen"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <Label Text="Setzt die gesamte App zurueck: Alle Trainingsplaene, Workout-Verlauf, Statistiken und Uebungseintraege werden geloescht. Die Standard-Uebungen werden neu geladen."
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13"
                               LineBreakMode="WordWrap" />

                        <Button x:Name="ResetAllButton"
                                Text="Alles zuruecksetzen"
                                Clicked="OnResetAllClicked"
                                BackgroundColor="#FF4444"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="8"
                                HeightRequest="50"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Info -->
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="#2A2A2A"
                        StrokeThickness="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ℹ️ App-Info"
                               TextColor="{StaticResource PrimaryAccent}"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label x:Name="AppVersionLabel"
                               Text="Version: 1.0"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="14" />

                        <Label x:Name="DbInfoLabel"
                               Text=""
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
