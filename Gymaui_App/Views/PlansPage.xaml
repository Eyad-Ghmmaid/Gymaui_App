<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:controls="clr-namespace:Gymaui_App.Controls"
x:Class="Gymaui_App.Views.PlansPage"
Title="Pläne"
BackgroundColor="#0D0D0D"
Padding="0">

    <Grid RowDefinitions="auto,*" ColumnDefinitions="*">
        
        <!-- Custom Header -->
        <controls:CustomHeader 
            x:Name="CustomHeader"
            Grid.Row="0"
            Title="Pläne"
            IconSource="plaene.png"
            ShowBackButton="False" />

        <!-- Content -->
        <VerticalStackLayout 
            Grid.Row="1"
            Padding="16" 
            Spacing="16"
            BackgroundColor="#0D0D0D">

            <!-- Create New Plan Section -->
            <Border Stroke="#2A2A2A" StrokeThickness="1" Padding="16" StrokeShape="RoundRectangle 8,8,8,8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Neuer Plan" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="#FFFFFF" />
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Entry x:Name="NewPlanNameEntry"
                               Placeholder="Planname"
                               PlaceholderColor="#8A8A8A"
                               TextColor="#FFFFFF"
                               BackgroundColor="#1A1A1A"
                               HorizontalOptions="FillAndExpand"/>
                        <Button Text="Erstellen" 
                                Clicked="OnCreatePlanClicked"
                                BackgroundColor="#E8FF47"
                                TextColor="#000000"
                                FontAttributes="Bold"
                                Padding="16,8"
                                WidthRequest="100"/>
                    </StackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Plans List -->
            <Label Text="Deine Pläne" 
                   FontSize="16" 
                   FontAttributes="Bold"
                   TextColor="#FFFFFF" />

            <CollectionView x:Name="PlansCollection" 
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems>
                                    <SwipeItem Text="✏ Bearbeiten" BackgroundColor="#E8FF47" Invoked="OnEditPlanSwipe" CommandParameter="{Binding .}" />
                                    <SwipeItem Text="✓ Aktivieren" BackgroundColor="#00AA00" Invoked="OnSetActiveSwipe" CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="🗑 Löschen" BackgroundColor="#FF4444" Invoked="OnDeletePlanSwipe" CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Stroke="#2A2A2A" StrokeThickness="1" Padding="16" Margin="0,8,0,0" StrokeShape="RoundRectangle 8,8,8,8">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <Label Grid.Column="0" Grid.Row="0"
                                           Text="{Binding Name}" 
                                           FontSize="16" 
                                           FontAttributes="Bold"
                                           TextColor="#E8FF47" />
                                    <Label Grid.Column="0" Grid.Row="1"
                                           Text="{Binding Created, StringFormat='Erstellt: {0:dd.MM.yyyy}'}" 
                                           FontSize="12" 
                                           TextColor="#8A8A8A" />
                                    <Label Grid.Column="1" Grid.Row="0"
                                           Text="Aktiv" 
                                           FontSize="12" 
                                           TextColor="#E8FF47"
                                           IsVisible="{Binding IsActive}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
