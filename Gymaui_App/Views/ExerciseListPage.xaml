<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:controls="clr-namespace:Gymaui_App.Controls"
x:Class="Gymaui_App.Views.ExerciseListPage"
Title="Exercises"
BackgroundColor="#0D0D0D"
Padding="0">

    <Grid RowDefinitions="auto,*" ColumnDefinitions="*">
        
        <!-- Custom Header -->
        <controls:CustomHeader 
            Grid.Row="0"
            Title="⚙️ Übungen"
            ShowBackButton="False" />

        <!-- Content -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="12" BackgroundColor="#0D0D0D">
            <!-- Header with title and Add button -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label Text="Meine Übungen" FontSize="20" VerticalOptions="Center" TextColor="#FFFFFF" FontAttributes="Bold" />
                <Button Text="+ Hinzufügen" Grid.Column="1" Clicked="OnAddClicked" BackgroundColor="#E8FF47" TextColor="#000000" FontAttributes="Bold" />
            </Grid>

            <!-- Collection of exercises -->
            <CollectionView Grid.Row="1" x:Name="ExercisesCollection" ItemsSource="{Binding Exercises}" SelectionMode="Single" SelectionChanged="OnExerciseSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#1A1A1A" StrokeThickness="1" Stroke="#2A2A2A" Padding="12" Margin="6" StrokeShape="RoundRectangle 8,8,8,8">
                            <Grid ColumnDefinitions="60,*,Auto,Auto">
                                <Image Source="{Binding ImagePath}" WidthRequest="48" HeightRequest="48" Aspect="AspectFill" VerticalOptions="Center" />

                                <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" FontSize="16" TextColor="#FFFFFF" FontAttributes="Bold" />

                                <Button Grid.Column="2" Text="Bearbeiten" Clicked="OnEditClicked" CommandParameter="{Binding .}" VerticalOptions="Center" BackgroundColor="#8A8A8A" TextColor="#000000" FontSize="12" Padding="8" />
                                <Button Grid.Column="3" Text="Stats" Clicked="OnStatsClicked" CommandParameter="{Binding Id}" VerticalOptions="Center" BackgroundColor="#8A8A8A" TextColor="#000000" FontSize="12" Padding="8" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>


