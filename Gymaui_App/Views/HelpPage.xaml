<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Gymaui_App.Controls"
             x:Class="Gymaui_App.Views.HelpPage"
             Title="Hilfe"
             BackgroundColor="#0D0D0D"
             Padding="0">

	<Grid RowDefinitions="Auto,*">

		<controls:CustomHeader
			Grid.Row="0"
			Title="Hilfe &amp; Anleitung"
			IconSource="help.png"
			ShowBackButton="False" />

		<ScrollView Grid.Row="1" Padding="16,12">
			<VerticalStackLayout Spacing="16">

				<Label Text="Willkommen bei Gymaui! Hier erfährst du, wie du die App nutzen kannst."
					   TextColor="#B0B0B0"
					   FontSize="15" />

				<Border Stroke="#2A2A2A" StrokeThickness="1" BackgroundColor="#1A1A1A"
						Padding="16" StrokeShape="RoundRectangle 10">
					<VerticalStackLayout Spacing="6">
						<Label Text="Übungen verwalten" FontSize="18" FontAttributes="Bold" TextColor="#E8FF47" />
						<Label Text="• Tippe auf das + Symbol, um eine neue Übung hinzuzufügen." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Nutze die Suchleiste, um schnell eine Übung zu finden." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Wische eine Übung nach links, um sie zu löschen." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Tippe auf eine Übung, um Details zu sehen oder sie zu bearbeiten." TextColor="#CCCCCC" FontSize="14" />
					</VerticalStackLayout>
				</Border>

				<Border Stroke="#2A2A2A" StrokeThickness="1" BackgroundColor="#1A1A1A"
						Padding="16" StrokeShape="RoundRectangle 10">
					<VerticalStackLayout Spacing="6">
						<Label Text="Trainingspläne erstellen" FontSize="18" FontAttributes="Bold" TextColor="#E8FF47" />
						<Label Text="• Gehe zum Tab Pläne und erstelle einen neuen Plan." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Füge Trainingstage hinzu und ordne Übungen zu." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Halte einen Plan gedrückt, um ihn zu bearbeiten oder zu löschen." TextColor="#CCCCCC" FontSize="14" />
					</VerticalStackLayout>
				</Border>

				<Border Stroke="#2A2A2A" StrokeThickness="1" BackgroundColor="#1A1A1A"
						Padding="16" StrokeShape="RoundRectangle 10">
					<VerticalStackLayout Spacing="6">
						<Label Text="Training starten" FontSize="18" FontAttributes="Bold" TextColor="#E8FF47" />
						<Label Text="• Gehe zum Tab Training und wähle einen Plan oder starte ein freies Training." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Trage deine Sätze, Gewicht und Wiederholungen ein." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Beende das Training, um es in der Historie zu speichern." TextColor="#CCCCCC" FontSize="14" />
					</VerticalStackLayout>
				</Border>

				<Border Stroke="#2A2A2A" StrokeThickness="1" BackgroundColor="#1A1A1A"
						Padding="16" StrokeShape="RoundRectangle 10">
					<VerticalStackLayout Spacing="6">
						<Label Text="Trainingshistorie" FontSize="18" FontAttributes="Bold" TextColor="#E8FF47" />
						<Label Text="• Im Tab Tage siehst du alle vergangenen Trainings." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Tippe auf ein Training, um die Details einzusehen." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Im Kalender-Tab kannst du deine Trainingstage im Überblick sehen." TextColor="#CCCCCC" FontSize="14" />
					</VerticalStackLayout>
				</Border>

				<Border Stroke="#2A2A2A" StrokeThickness="1" BackgroundColor="#1A1A1A"
						Padding="16" StrokeShape="RoundRectangle 10">
					<VerticalStackLayout Spacing="6">
						<Label Text="Statistiken" FontSize="18" FontAttributes="Bold" TextColor="#E8FF47" />
						<Label Text="• Im Tab Statistik siehst du deinen Fortschritt über die Zeit." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Verfolge dein Gesamtvolumen, Trainingsfrequenz und mehr." TextColor="#CCCCCC" FontSize="14" />
					</VerticalStackLayout>
				</Border>

				<Border Stroke="#2A2A2A" StrokeThickness="1" BackgroundColor="#1A1A1A"
						Padding="16" StrokeShape="RoundRectangle 10">
					<VerticalStackLayout Spacing="6">
						<Label Text="Löschen &amp; Bearbeiten" FontSize="18" FontAttributes="Bold" TextColor="#E8FF47" />
						<Label Text="• Wische ein Element nach links, um die Lösch-Option anzuzeigen." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Wische ein Element nach rechts, um Bearbeitungsoptionen zu öffnen." TextColor="#CCCCCC" FontSize="14" />
						<Label Text="• Bestätige das Löschen im erscheinenden Dialog." TextColor="#CCCCCC" FontSize="14" />
					</VerticalStackLayout>
				</Border>

			</VerticalStackLayout>
		</ScrollView>

	</Grid>

</ContentPage>
