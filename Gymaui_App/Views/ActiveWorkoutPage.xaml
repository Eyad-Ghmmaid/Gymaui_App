<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:controls="clr-namespace:Gymaui_App.Controls"
            xmlns:converters="clr-namespace:Gymaui_App.Converters"
            x:Class="Gymaui_App.Views.ActiveWorkoutPage"
            Title="Training"
            BackgroundColor="#0D0D0D"
            Padding="0">
<ContentPage.Resources>
<ResourceDictionary>
<converters:CompletionBackgroundConverter x:Key="CompletionBackgroundConverter" />
<converters:CompletionTextConverter x:Key="CompletionTextConverter" />
<converters:CompletionTextColorConverter x:Key="CompletionTextColorConverter" />
</ResourceDictionary>
</ContentPage.Resources>
    <Grid RowDefinitions="auto,*" ColumnDefinitions="*">

        <!-- Custom Header -->
        <controls:CustomHeader
            x:Name="CustomHeader"
            Grid.Row="0"
            Title="&#x1F4AA; Training"
            ShowBackButton="False" />

        <!-- Content -->
        <Grid Grid.Row="1" Padding="12" RowDefinitions="Auto, *" BackgroundColor="#0D0D0D">
            <Label Text="Aktives Training" FontSize="20" Grid.Row="0" TextColor="#FFFFFF" FontAttributes="Bold" />

            <CollectionView x:Name="ExercisesCollection"
                            Grid.Row="1"
                            ItemsSource="{Binding}"
                            SelectionMode="Single"
                            SelectionChanged="OnExerciseSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#2A2A2A"
                                StrokeThickness="1"
                                Padding="8"
                                Margin="6"
                                BackgroundColor="#1A1A1A">
                            <!-- Main Grid with padding to avoid button cutoff -->
                            <Grid ColumnDefinitions="*,50" ColumnSpacing="8" Padding="0,0,5,0">

                                <!-- Details Grid (Column 0): Name over Reps -->
                                <Grid Grid.Column="0" RowDefinitions="*,*" VerticalOptions="Center">
                                    <!-- Exercise Name (Row 0) -->
                                    <Label Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontSize="16"
                                           TextColor="#FFFFFF"
                                           FontAttributes="Bold"
                                           VerticalOptions="End"
                                           LineBreakMode="TailTruncation" />

                                    <!-- Reps Count (Row 1) -->
                                    <Label Grid.Row="1"
                                           Text="{Binding TargetReps, StringFormat='{0} Wdh'}"
                                           FontSize="14"
                                           TextColor="#E8FF47"
                                           FontAttributes="Bold"
                                           VerticalOptions="Start" />
                                </Grid>

                                <!-- Done Button (Column 1) - bound to IsCompleted via converters -->
                                <Button Grid.Column="1"
                                        Text="{Binding IsCompleted, Converter={StaticResource CompletionTextConverter}}"
                                        Clicked="OnExerciseCompletionToggled"
                                        BackgroundColor="{Binding IsCompleted, Converter={StaticResource CompletionBackgroundConverter}}"
                                        TextColor="{Binding IsCompleted, Converter={StaticResource CompletionTextColorConverter}}"
                                        CornerRadius="16"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center"
                                        HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
