<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Gymaui_App.Controls"
             x:Class="Gymaui_App.Views.StatisticsPage"
             Title="Statistiken"
             BackgroundColor="{StaticResource BackgroundDark}"
             Padding="0">

    <Grid RowDefinitions="auto,*" ColumnDefinitions="*">
        
        <controls:CustomHeader 
            x:Name="CustomHeader"
            Grid.Row="0"
            Title="📊 Statistiken"
            ShowBackButton="False" />

        <RefreshView Grid.Row="1"
                     x:Name="StatsRefreshView"
                     Refreshing="OnRefreshClicked"
                     RefreshColor="{StaticResource PrimaryAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="12" BackgroundColor="{StaticResource BackgroundDark}">
                
                <Label Text="Uebung auswaehlen:" FontSize="14" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                <Picker x:Name="ExercisePicker" 
                        Title="Uebung waehlen..."
                        BackgroundColor="{StaticResource Surface}"
                        TextColor="{StaticResource PrimaryAccent}"
                        TitleColor="{StaticResource TextSecondary}"
                        SelectedIndexChanged="OnExerciseSelected" />

                <Label x:Name="ExerciseNameLabel" 
                       Text="Keine Uebung gewaehlt"
                       TextColor="{StaticResource PrimaryAccent}" 
                       FontAttributes="Bold"
                       FontSize="18" />

                <!-- Stats Cards Row 1 -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Border Grid.Column="0" Grid.Row="0"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="#2A2A2A"
                            StrokeThickness="1"
                            Padding="12"
                            StrokeShape="RoundRectangle 8,8,8,8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🏆 Max Gewicht" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label x:Name="MaxWeightLabel" Text="-" FontSize="20" TextColor="{StaticResource PrimaryAccent}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="0"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="#2A2A2A"
                            StrokeThickness="1"
                            Padding="12"
                            StrokeShape="RoundRectangle 8,8,8,8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📈 Durchschnitt" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label x:Name="AvgWeightLabel" Text="-" FontSize="20" TextColor="{StaticResource PrimaryAccent}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Stats Cards Row 2 -->
                    <Border Grid.Column="0" Grid.Row="1"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="#2A2A2A"
                            StrokeThickness="1"
                            Padding="12"
                            StrokeShape="RoundRectangle 8,8,8,8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📋 Einträge" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label x:Name="EntryCountLabel" Text="0" FontSize="20" TextColor="{StaticResource PrimaryAccent}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="1"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="#2A2A2A"
                            StrokeThickness="1"
                            Padding="12"
                            StrokeShape="RoundRectangle 8,8,8,8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📅 Letzter Eintrag" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label x:Name="LastDateLabel" Text="-" FontSize="16" TextColor="{StaticResource PrimaryAccent}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    </Grid>

                <!-- PR Badge -->
                <Border x:Name="PRBadge"
                        BackgroundColor="#1A3300"
                        Stroke="#00AA00"
                        StrokeThickness="1"
                        Padding="12"
                        StrokeShape="RoundRectangle 8,8,8,8"
                        IsVisible="False">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🏆" FontSize="20" VerticalOptions="Center" />
                        <Label x:Name="PRLabel" Text="" FontSize="14" TextColor="#00AA00" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Label Text="Gewichtsverlauf" FontSize="14" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="#2A2A2A"
                        StrokeThickness="1"
                        Padding="0"
                        StrokeShape="RoundRectangle 8,8,8,8"
                        HeightRequest="320">
                    <GraphicsView x:Name="ChartView" HeightRequest="300" />
                </Border>

                <Label x:Name="NoDataLabel"
                       Text="Keine Daten vorhanden. Trainiere um Statistiken zu sehen."
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"
                       IsVisible="False"
                       Margin="0,12,0,0" />

            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
