<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:controls="clr-namespace:Gymaui_App.Controls"
x:Class="Gymaui_App.Views.StartPage"
Title="Home"
BackgroundColor="#0D0D0D"
Padding="0">

    <Grid RowDefinitions="auto,*" ColumnDefinitions="*">
        
        <!-- Custom Header -->
        <controls:CustomHeader 
            Grid.Row="0"
            Title="🏠 Home"
            ShowBackButton="False" />

        <!-- Content -->
        <StackLayout 
            Grid.Row="1"
            Padding="20" 
            Spacing="16" 
            VerticalOptions="FillAndExpand"
            BackgroundColor="#0D0D0D">
            
            <Label Text="HOME PAGE TEST" 
                   FontSize="28" 
                   HorizontalOptions="Center"
                   TextColor="#E8FF47"
                   FontAttributes="Bold" />
            
            <Label x:Name="MessageLabel" 
                   Text="Initializing..." 
                   FontSize="18" 
                   HorizontalOptions="Center"
                   TextColor="#FFFFFF" />

            <Button x:Name="CreatePlanButton" 
                    Text="Trainingsplan erstellen" 
                    Clicked="OnCreatePlanClicked" 
                    IsVisible="False"
                    BackgroundColor="#E8FF47"
                    TextColor="#000000"
                    FontAttributes="Bold" />

            <StackLayout x:Name="ActivePlanLayout" IsVisible="False" Spacing="12">
                <Label Text="Aktiver Trainingsplan:" 
                       FontAttributes="Bold"
                       TextColor="#FFFFFF" />
                <Label x:Name="PlanNameLabel" 
                       FontSize="18"
                       TextColor="#E8FF47" />
                
                <!-- Today's Workout Info -->
                <Border Padding="12" BackgroundColor="#1A1A1A" Stroke="#2A2A2A" StrokeThickness="1">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="TodayLabel" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="#FFFFFF" />
                        <Label x:Name="TodayStatusLabel" 
                               FontSize="13"
                               TextColor="#8A8A8A" />
                        <CollectionView x:Name="TodayExercisesCollection" 
                                        SelectionMode="None"
                                        HeightRequest="150">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding Name, StringFormat='• {0}'}"
                                           TextColor="#E8FF47"
                                           Padding="4" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Button x:Name="StartTrainingButton" 
                        Text="Training starten" 
                        Clicked="OnStartTrainingClicked"
                        BackgroundColor="#E8FF47"
                        TextColor="#000000"
                        FontAttributes="Bold" />
            </StackLayout>
        </StackLayout>
    </Grid>

</ContentPage>

